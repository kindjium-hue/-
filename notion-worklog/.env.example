# 이 파일을 .env로 복사해서 값을 채우세요. .env는 git에 올라가지 않습니다.

# notion.so/my-integrations 에서 발급한 Internal Integration Secret
NOTION_TOKEN=ntn_여기에붙여넣기

# setup_db.py가 알려주는 데이터베이스 ID (32자리)
NOTION_DATABASE_ID=

# 폼을 아무나 열지 못하게 막는 공용 코드. 비워 두면 잠금 없음.
WORKLOG_ACCESS_CODE=

# 사진 긴 변 최대 픽셀 (기본 2000)
WORKLOG_MAX_IMAGE_PX=2000

# 파일 하나당 허용 크기 MB (기본 40). 노션 무료 플랜은 실제로 5MB까지만 받습니다.
WORKLOG_MAX_UPLOAD_MB=40
